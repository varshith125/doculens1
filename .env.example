# Copy into backend/.env. Never expose the backend directly to an untrusted network.
DOCULENS_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8000","http://127.0.0.1:8000"]
DOCULENS_ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]
DOCULENS_COOKIE_SECURE=false
DOCULENS_RETENTION_SECONDS=60
DOCULENS_MAX_UPLOAD_MB=12
DOCULENS_MAX_ACTIVE_SCANS=8
DOCULENS_WORKERS=1
# OCR model files (see models/README.md). Paths are relative to the backend folder.
# Without these lines RapidOCR's own default models are used.
# DOCULENS_OCR_MODELS_DIR=../models/ocr
# DOCULENS_OCR_MEDIUM_DET_PATH=../models/ocr/medium-det/inference.onnx
# DOCULENS_OCR_MEDIUM_REC_PATH=../models/ocr/medium-rec/inference.onnx
# Small recogniser for the first read, Medium for rereads: about 40 % faster, same accuracy.
DOCULENS_OCR_FAST_TEXT=true
# Optional Tesseract OCR Backup Engine settings (Tier 3 fallback)
# DOCULENS_ENABLE_TESSERACT_BACKUP=true
# DOCULENS_TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# DOCULENS_TESSDATA_DIR=C:\Program Files\Tesseract-OCR\tessdata_best
# DOCULENS_TESSERACT_LANGUAGE=eng
# Optional override; the default is <project>/models/semantic.
# Install once with: .venv/Scripts/python.exe scripts/setup_semantic_model.py
# DOCULENS_SEMANTIC_MODELS_DIR=D:/path/to/semantic
