# Copy into backend/.env. Never expose the backend directly to an untrusted network.
DOCULENS_ALLOWED_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173","http://localhost:8000","http://127.0.0.1:8000"]
DOCULENS_ALLOWED_HOSTS=["localhost","127.0.0.1","testserver"]
DOCULENS_COOKIE_SECURE=false
DOCULENS_RETENTION_SECONDS=60
DOCULENS_MAX_UPLOAD_MB=12
DOCULENS_MAX_ACTIVE_SCANS=8
DOCULENS_WORKERS=1
# Fast first-pass text recognition; configured Medium Rec is used for uncertain crops.
DOCULENS_OCR_FAST_TEXT=true
# Optional local PP-OCRv6 bundle (all four files listed in README are required).
# DOCULENS_OCR_MODELS_DIR=D:/DocuLens-OCR-Models
# Optional per-stage Medium ONNX exports. Each requires its same-stem .yml.
# Leave a stage unset to use Small. An invalid explicit path stops startup.
# DOCULENS_OCR_MEDIUM_DET_PATH="D:/DocuLens-OCR-Modelsmedium-det/inference (1).onnx"
# DOCULENS_OCR_MEDIUM_REC_PATH=D:/DocuLens-OCR-Modelsmedium/inference.onnx
# Optional pre-downloaded Arabic recognition model; see README for required dictionary.
# DOCULENS_ARABIC_MODEL_PATH=/absolute/path/arabic_PP-OCRv4_rec_mobile.onnx
# DOCULENS_ARABIC_DICTIONARY_PATH=/absolute/path/arabic_dict.txt
